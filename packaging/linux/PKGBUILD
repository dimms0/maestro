# Maintainer: dimms
pkgname=maestro
pkgver=0.1.0
pkgrel=1
pkgdesc="A MIDI synthesizer host"
arch=('x86_64' 'aarch64')
url="https://dimms.gr/maestro"
license=('LGPL-3.0-or-later')
depends=('alsa-lib' 'fluidsynth')
optdepends=('jack2: JACK backend' 'pipewire-jack: JACK via PipeWire')
makedepends=('cargo')

# BASS, BASSMIDI and BASSFLAC are proprietary (Un4seen Developments) and are
# pulled straight from Un4seen's own distribution. One archive per add-on
# covers every Linux architecture under libs/$CARCH/, and the archives are
# versionless (always the current 2.4 build), hence the SKIP checksums.
source=("$pkgname-$pkgver.tar.gz::https://github.com/dimms0/maestro/archive/refs/tags/v$pkgver.tar.gz"
        "bass24-linux.zip::https://www.un4seen.com/files/bass24-linux.zip"
        "bassmidi24-linux.zip::https://www.un4seen.com/files/bassmidi24-linux.zip"
        "bassflac24-linux.zip::https://www.un4seen.com/files/bassflac24-linux.zip")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/maestro "$pkgdir/usr/bin/maestro"
    install -Dm755 target/release/maestrod "$pkgdir/usr/bin/maestrod"
    install -Dm644 crates/maestro-daemon/service/maestrod.service \
        "$pkgdir/usr/lib/systemd/user/maestrod.service"
    install -Dm644 packaging/linux/gr.dimms.maestro.desktop \
        "$pkgdir/usr/share/applications/gr.dimms.maestro.desktop"
    install -Dm644 assets/icons/maestro.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/gr.dimms.maestro.svg"
    install -Dm644 assets/icons/maestro-256.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/gr.dimms.maestro.png"
    install -Dm644 LICENSE.md "$pkgdir/usr/share/doc/$pkgname/LICENSE.md"
    install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/doc/$pkgname/THIRD-PARTY-NOTICES.md"
    install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/doc/$pkgname/OFL.txt"

    install -Dm755 target/release/libOmniMIDI.so "$pkgdir/usr/share/maestro/lib/libOmniMIDI.so"

    local lib
    for lib in libbass.so libbassmidi.so libbassflac.so; do
        install -Dm755 "$srcdir/libs/$CARCH/$lib" "$pkgdir/usr/share/maestro/lib/$lib"
    done
    for lib in bass.txt bassmidi.txt bassflac.txt; do
        install -Dm644 "$srcdir/$lib" "$pkgdir/usr/share/doc/$pkgname/$lib"
    done
}
