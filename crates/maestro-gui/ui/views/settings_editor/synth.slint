import {
    Theme,
    MaestroCard,
    MaestroCheckBox,
    MaestroComboBox,
    MaestroSpinBox,
    MaestroLineEdit,
    MaestroSynthComboBox,
    HorizontalSeparator,
    VerticalSeparator,
    TitleText,
    BodyText,
    LabelText,
    MaestroSwitch,
    Setting,
    SectionCard,
} from "../../widgets.slint";
import { SettingsEditorState } from "../../globals.slint";
import { SynthKind } from "../../enums.slint";
import { SlintSynthConfig } from "../../structs.slint";

// Base for the per-synth panels: gives each one the scratch copy it edits and a
// single `commit()` so no panel repeats the update plumbing.
//
// The scratch is refreshed from the authoritative config on every commit, so an
// external change (Discard, switching component) can never be undone by a later
// edit re-sending stale values.
component SynthPanel inherits VerticalLayout {
    in-out property <SlintSynthConfig> edit;
    spacing: 12px;

    public function commit() {
        SettingsEditorState.update_synth(root.edit);
    }

    @children
}

component FluidSynthPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    // Keeps the multi-core group on screen whenever it is actually doing
    // something, so a setting that is in effect is never hidden behind the
    // advanced toggle. One core is the default (single-threaded rendering).
    property <bool> multicore_set: SettingsEditorState.current_config.synth.fluid_cpu_cores > 1;

    edit: SettingsEditorState.current_config.synth;

    SectionCard {
        title: "General";

        Setting {
            text: "Polyphony";
            subtext: "The polyphony defines how many voices can be played in parallel. A note event produces one or more voices. Its good to set this to a value which the system can handle and will thus limit FluidSynth's CPU usage. When FluidSynth runs out of voices it will begin terminating lower priority voices for new note events.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 65535;
                value: SettingsEditorState.current_config.synth.fluid_voice_limit;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_voice_limit = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Interpolation Method";
            subtext: "Sets the default interpolation method, used to resample the SoundFont's samples to the notes being played. Higher orders sound cleaner (less aliasing) at the cost of CPU time.";

            MaestroComboBox {
                width: 150px;
                model: ["None", "Linear", "Sinc 4th Order", "Sinc 7th Order"];
                current_index: SettingsEditorState.current_config.synth.fluid_interpolation;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_interpolation = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "MIDI Bank Select";
            subtext: "How bank select messages (CC0 / CC32) are interpreted. \"GS\" uses CC0 as the bank, \"XG\" uses CC32 and reserves CC0 values 120, 126 and 127 for drum kits, \"GM\" ignores bank selects entirely, and \"MMA\" combines both controllers into one bank number (CC0 * 128 + CC32).";

            MaestroComboBox {
                width: 150px;
                model: ["GS", "GM", "GM2", "XG", "MMA"];
                current_index: SettingsEditorState.current_config.synth.fluid_midi_bank_select;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_midi_bank_select = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Portamento Time";
            subtext: "How the portamento time controller (CC5) is converted to a duration. \"Automatic\" follows whichever MIDI standard the file identifies itself as, \"Linear\" maps the controller straight onto milliseconds, and \"XG / GS\" uses the curve those standards define.";

            MaestroComboBox {
                width: 150px;
                model: ["Automatic", "Linear", "XG / GS"];
                current_index: SettingsEditorState.current_config.synth.fluid_portamento_time;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_portamento_time = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Minimum Note Length (ms)";
            subtext: "Sets the minimum note duration in milliseconds. This ensures that really short duration note events, such as percussion notes, have a better chance of sounding as intended. Set to 0 to disable this feature.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 65535;
                value: SettingsEditorState.current_config.synth.fluid_min_note_length;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_min_note_length = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Device ID";
            subtext: "Device identifier used for SYSEX commands, such as MIDI Tuning Standard commands. Fluidsynth will only process those SYSEX commands destined for this ID (except when this setting is set to 127, which causes fluidsynth to process all SYSEX commands, regardless of the device ID). Broadcast commands (with ID=127) will always be processed. It has been observed that setting this ID to 16 provides best compatibility when playing MIDI files which contain SYSEX commands that you want to have honored.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 127;
                value: SettingsEditorState.current_config.synth.fluid_system_id;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_system_id = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Repeated Note Handling";
            subtext: "What happens when a note-on arrives for a key that is already sounding on the same channel: the notes can be left to overlap, or the older voice can be released (letting its volume envelope fade out) or cut off at once.";

            MaestroComboBox {
                width: 150px;
                model: ["Overlap", "Release Previous", "Cut Previous"];
                current_index: SettingsEditorState.current_config.synth.fluid_note_cut;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_note_cut = i;
                    root.commit();
                }
            }
        }
    }

    SectionCard {
        title: "Chorus";

        Setting {
            text: "Enable Chorus";
            subtext: "When enabled the chorus effects module is activated. Otherwise, no chorus will be added to the output signal. The amount of signal sent to the chorus module depends on the \"chorus send\" generator defined in the SoundFont.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.fluid_chorus;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_chorus = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Depth";
            subtext: "Specifies the modulation depth of the chorus.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 256;
                step: 0.25;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_chorus;
                value: SettingsEditorState.current_config.synth.fluid_chorus_depth;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_chorus_depth = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Level";
            subtext: "Specifies the output amplitude of the chorus signal.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 10;
                step: 0.1;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_chorus;
                value: SettingsEditorState.current_config.synth.fluid_chorus_level;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_chorus_level = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Speed";
            subtext: "Sets the modulation speed in Hz.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0.1;
                maximum: 5;
                step: 0.1;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_chorus;
                value: SettingsEditorState.current_config.synth.fluid_chorus_speed;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_chorus_speed = v;
                    root.commit();
                }
            }
        }
    }

    SectionCard {
        title: "Reverb";

        Setting {
            text: "Enable Reverb";
            subtext: "When enabled the reverb effects module is activated. Otherwise, no reverb will be added to the output signal. The amount of signal sent to the reverb module depends on the \"reverb send\" generator defined in the SoundFont.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.fluid_reverb;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Reverb Engine";
            subtext: "The algorithm that produces the reverb. More information at https://www.fluidsynth.org/wiki/reverbators/";

            MaestroComboBox {
                width: 150px;
                model: ["Freeverb", "FDN", "Lexverb", "Dattorro", "Signalsmith"];
                enabled: SettingsEditorState.current_config.synth.fluid_reverb;
                current_index: SettingsEditorState.current_config.synth.fluid_reverb_engine;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb_engine = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Room Size";
            subtext: "Sets the room size (i.e. decay duration of wet) reverb.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 1;
                step: 0.05;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_reverb;
                value: SettingsEditorState.current_config.synth.fluid_reverb_roomsize;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb_roomsize = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Damping";
            subtext: "Sets how much the high frequencies are damped as the reverb decays. Higher values make the tail darker and shorter.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 1;
                step: 0.05;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_reverb;
                value: SettingsEditorState.current_config.synth.fluid_reverb_damp;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb_damp = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Width";
            subtext: "Sets the stereo spread of the reverb signal, i.e. how much the wet-left signal contributes to the wet-right signal and vice versa. A value of 0 indicates no stereo-spread causing the reverb to sound like a monophonic signal. A value of 1 indicates maximum spread between the uncorrelated left and right channels. This subrange [0;1] is recommended for general usage. Values bigger than 1 increase (or exaggerate) the perception of the uncorrelated left and right signals.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 100;
                step: 1;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_reverb;
                value: SettingsEditorState.current_config.synth.fluid_reverb_width;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb_width = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Level";
            subtext: "Specifies the output amplitude of the reverb signal.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 1;
                step: 0.05;
                decimals: 2;
                enabled: SettingsEditorState.current_config.synth.fluid_reverb;
                value: SettingsEditorState.current_config.synth.fluid_reverb_level;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_reverb_level = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced || root.multicore_set): SectionCard {
        title: "Multi-Threading";

        Setting {
            text: "CPU Cores";
            subtext: "Sets the number of synthesis CPU cores. If set to a value greater than 1, additional synthesis threads will be created to do the actual rendering work that is then returned synchronously by the render function. This has the affect of utilizing more of the total CPU for voices or decreasing render times when synthesizing audio. So for example, if you set cpu-cores to 4, fluidsynth will attempt to split the synthesis work it needs to do between the client's calling thread and three additional (internal) worker threads. As soon as all threads have done their work, their results are collected and the resulting buffer is returned to the caller.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 256;
                value: SettingsEditorState.current_config.synth.fluid_cpu_cores;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_cpu_cores = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): SectionCard {
        title: "Voice Killing from Overflow Score";

        Setting {
            text: "According to Age";
            subtext: "This score is divided by the number of seconds this voice has been active and is added to the overflow priority. It is usually a positive value and gives voices which have just been started a higher priority, making them less likely to be killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_age;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_age = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Percussion";
            subtext: "Sets the overflow priority score added to voices on a percussion channel. This is usually a positive score, to give percussion voices a higher priority and less chance of being killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_percussion;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_percussion = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Released State";
            subtext: "Sets the overflow priority score added to voices that have already received a note-off event. This is usually a negative score, to give released voices a lower priority so that they are killed first in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_released;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_released = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Sustained Notes";
            subtext: "Sets the overflow priority score added to voices that are currently sustained. With the default value, sustained voices are considered less important and are more likely to be killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_sustained;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_sustained = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Volume Multiplier";
            subtext: "Sets the overflow priority score added to voices based on their current volume. The voice volume is normalized to a value between 0 and 1 and multiplied with this setting. So voices with maximum volume get added the full score, voices with only half that volume get added half of this score.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_volume;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_volume = v;
                    root.commit();
                }
            }
        }
    }
}

component BassMidiPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    // Keeps the SoundFont group on screen when any of its flags is set, so a
    // setting that is actually in effect is never hidden behind the advanced
    // toggle. All seven default to false.
    property <bool> sf_options_set:
        SettingsEditorState.current_config.synth.bass_sf_linear_attack_mod
        || SettingsEditorState.current_config.synth.bass_sf_linear_decay_vol
        || SettingsEditorState.current_config.synth.bass_sf_minfx
        || SettingsEditorState.current_config.synth.bass_sf_nofx
        || SettingsEditorState.current_config.synth.bass_sf_no_rampin
        || SettingsEditorState.current_config.synth.bass_sf_sb_limits
        || SettingsEditorState.current_config.synth.bass_sf_xg_drums;

    edit: SettingsEditorState.current_config.synth;

    SectionCard {
        title: "General";

        Setting {
            text: "Active Voice Limit";
            subtext: "This is not necessarily the same thing as the maximum number of notes, due to presets possibly containing multiple layered samples, ie. multiple samples may be played for a single note. When the voice limit is hit, the voice with the lowest volume level will be killed.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 2147483648;
                value: SettingsEditorState.current_config.synth.bass_voice_limit;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_voice_limit = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Interpolation Method";
            subtext: "The linear interpolation option uses less CPU, but the sinc interpolation gives better sound quality (less aliasing), with the quality and CPU usage increasing with the number of points.";

            MaestroComboBox {
                width: 150px;
                model: ["None", "Linear", "8 Point Sinc", "16 Point Sinc"];
                current_index: SettingsEditorState.current_config.synth.bass_interpolation;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_interpolation = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Render Time Limit (%)";
            subtext: "How timely the stream is able to render data. When the limit is exceeded, BASSMIDI will begin killing voices, starting with the most quiet. This does not affect MIDI event decoding.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 100;
                value: SettingsEditorState.current_config.synth.bass_render_time_limit;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_render_time_limit = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Exclusive Notes";
            subtext: "When enabled, this attribute effectively gives each key its own exclusive class/group. Any keys that are already assigned to an exclusive class/group by the active soundfont are unaffected.";

            MaestroComboBox {
                width: 150px;
                model: ["Disabled", "Only Drums", "All Notes"];
                current_index: SettingsEditorState.current_config.synth.bass_exclusive_keys;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_exclusive_keys = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Disable Audio Effects";
            subtext: "Disable reverb and chorus processing, saving some CPU time.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_disable_effects;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_disable_effects = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Killed Note Fading";
            subtext: "Fade out voices when killing them.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_fade_out_killing;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_fade_out_killing = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Don't Follow Overlaps on Note-Off Events";
            subtext: "Only release the oldest instance upon a note off event when there are overlapping instances of the note. Otherwise all instances are released.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_note_off1;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_note_off1 = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced || SettingsEditorState.current_config.synth.bass_multithreading): SectionCard {
        title: "Multi-Threading";

        Setting {
            text: "Enable Multi-Threading";
            subtext: "Multithreading will improve performance on larger MIDIs, although some MIDI features might not always work correctly (portamento, SysEx etc.). Each thread will have a separate BASSMIDI instance.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_multithreading;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_multithreading = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Custom Thread Count";
            has-switch: true;
            subtext: "The audio rendering of the various synthesizer instances will be split between this amount of threads. When disabled, Maestro determines the number of threads automatically.";
            enabled: SettingsEditorState.current_config.synth.bass_multithreading;
            checked: SettingsEditorState.current_config.synth.bass_custom_thread_count;

            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_custom_thread_count = v;
                root.commit();
            }

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 128;
                value: SettingsEditorState.current_config.synth.bass_thread_count;
                enabled: SettingsEditorState.current_config.synth.bass_multithreading
                    && SettingsEditorState.current_config.synth.bass_custom_thread_count;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_thread_count = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Divide Instances Between Channels";
            subtext: "If enabled, Maestro will assign an equal number of instances to each of the 16 MIDI channels. This will provide complete separation of the channels for each instance. It may improve performance for MIDIs with a lot of control events (CC, pitch etc.) but will conceptually decrease the voice cap of each channel.";

            MaestroSwitch {
                enabled: SettingsEditorState.current_config.synth.bass_multithreading;
                checked: SettingsEditorState.current_config.synth.bass_divide_channels;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_divide_channels = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Real-Time Thread Priority";
            subtext: "Runs the rendering threads at real-time priority, which helps avoid stutters under heavy load. On lower end systems this can make the rest of the desktop unresponsive while playing.";

            MaestroSwitch {
                enabled: SettingsEditorState.current_config.synth.bass_multithreading;
                checked: SettingsEditorState.current_config.synth.bass_realtime_priority;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_realtime_priority = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced || root.sf_options_set): SectionCard {
        title: "SoundFont Options";

        Setting {
            text: "Use a linear attack phase in SF2 modulation (pitch/filter) envelopes";
            subtext: "Otherwise a convex curve is used. The attack phase is always linear in SFZ envelopes.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_linear_attack_mod;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_linear_attack_mod = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Use linear decay and release phases in volume envelopes";
            subtext: "Otherwise a concave curve is used. The attack phase is always linear.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_linear_decay_vol;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_linear_decay_vol = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Treat the reverb / chorus levels in the SoundFont as minimums";
            subtext: "The higher of them and the MIDI levels (CC91/93) will be used instead of the sum of both.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_minfx;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_minfx = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Ignore the reverb / chorus levels in the SoundFont and only use the MIDI levels";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_nofx;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_nofx = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Never ramp-in the start of a sample in the SoundFont";
            subtext: "Otherwise a sample will be ramped-in if its data does not begin with a 0 (further away results in a longer ramp). This is only relevant when the volume envelope has no attack phase.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_no_rampin;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_no_rampin = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Emulate Creative / SoundBlaster hardware filter and SF2 generator limits";
            subtext: "This flag only applies to SF2 files. If disabled, the emulation will be determined by how the file was created, with it being enabled if the file's \"ISFT\" chunk contains \"SFEDT\" or \"E-mu Systems SoundFont Designer\".";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_sb_limits;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_sb_limits = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Use bank 127 in the SoundFont for XG drum kits";
            subtext: "When an XG drum kit is needed, bank 127 in soundfonts will be checked first, before falling back to bank 128 (the standard SF2 drum kit bank) if it is not available there.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_xg_drums;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_xg_drums = v;
                    root.commit();
                }
            }
        }
    }
}

// SuperVirtualMIDISynth renders through isolated offline sessions: each port
// owns one session holding a single SoundFont, and every setting is fixed when
// the session is created, so any change rebuilds the synthesizer.
component SVMSPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    edit: SettingsEditorState.current_config.synth;

    SectionCard {
        title: "General";

        Setting {
            text: "Voice Limit";
            subtext: "The maximum number of voices SuperVirtualMIDISynth plays at once. When the limit is reached, existing voices are stolen to make room for new notes. Every port loads its own copy of the SoundFont and voice pool.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 524288;
                value: SettingsEditorState.current_config.synth.svms_voice_limit;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.svms_voice_limit = v;
                    root.commit();
                }
            }
        }
    }

    SectionCard {
        title: "Performance";

        Setting {
            text: "Render Threads";
            subtext: "The number of threads each port renders its voices with. 0 picks automatically (up to 16). Event ordering and voice allocation always stay on one thread; helpers only render voices.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 64;
                value: SettingsEditorState.current_config.synth.svms_render_threads;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.svms_render_threads = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Render Backend";
            subtext: "The instruction set used for voice rendering. \"Automatic\" picks the fastest one this CPU supports. Choosing one the CPU lacks makes the synthesizer fail to start.";

            MaestroComboBox {
                width: 150px;
                model: ["Automatic", "Scalar", "SSE2", "AVX2"];
                current_index: SettingsEditorState.current_config.synth.svms_render_backend;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.svms_render_backend = i;
                    root.commit();
                }
            }
        }
    }
}

component GpuRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <bool> current;

    callback clicked;

    height: 48px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.current ? Theme.border_focus : Theme.border_color;
    background: root.current ? Theme.primary : (touch.has-hover ? Theme.bg_card_hover : Theme.bg_input);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            border-width: 2px;
            border-color: root.current ? Theme.border_focus : Theme.text_secondary;

            if (root.current): Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.border_focus;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            BodyText {
                text: root.name;
                overflow: elide;
            }

            LabelText {
                text: root.detail;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

component KestrelPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    edit: SettingsEditorState.current_config.synth;

    SectionCard {
        title: "GPU";

        LabelText {
            font-size: 10px;
            text: "The graphics card Kestrel renders on, the backend it is opened through, and the most voices it can hold at these settings. Automatic picks a dedicated card over an integrated one, and Vulkan or Metal over DX12.";
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            for gpu[i] in SettingsEditorState.kestrel_gpus: GpuRow {
                name: gpu.name;
                detail: gpu.detail;
                current: i == SettingsEditorState.current_config.synth.kestrel_gpu;
                clicked => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_gpu = i;
                    root.commit();
                }
            }
        }
    }

    SectionCard {
        title: "General";

        Setting {
            text: "Voice Limit";
            subtext: "The maximum number of voices Kestrel plays at once, per port. The voice pool lives in video memory: about 250 MB per million voices. A limit over what the GPU can hold is lowered to its maximum.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 16777216;
                value: SettingsEditorState.current_config.synth.kestrel_voice_limit;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_voice_limit = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Interpolation Method";
            subtext: "How samples are resampled to the notes being played. Cubic sounds cleaner but reads twice as much sample data per voice.";

            MaestroComboBox {
                width: 150px;
                model: ["Nearest", "Linear", "Cubic"];
                current_index: SettingsEditorState.current_config.synth.kestrel_interpolation;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_interpolation = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "BASSMIDI Note Grid";
            subtext: "Moves note envelopes in 4 ms steps like BASSMIDI does, so notes shorter than 4 ms still sound. Only needed for files that rely on it, and costs about 12% of rendering speed.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_note_grid;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_note_grid = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Max Steal Percent";
            subtext: "How much of the voice pool one block may take over from sounding voices when the pool is full. Lower values let the notes that do start ring for longer; 100 lets a dense passage replace the whole pool every block, which pumps.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 100;
                value: SettingsEditorState.current_config.synth.kestrel_steal_percent;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_steal_percent = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): SectionCard {
        title: "SoundFont Playback";

        Setting {
            text: "Low-Pass Filter";
            subtext: "Runs each voice through the SoundFont's low-pass filter. Presets that leave the cutoff at its default skip it either way.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_filter;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_filter = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Vibrato and Tremolo";
            subtext: "Plays the SoundFont's vibrato and tremolo LFOs. Many General MIDI SoundFonts rely on them.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_lfo;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_lfo = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Modulation Envelope";
            subtext: "Plays the SoundFont's modulation envelope and its pitch and filter sweeps, which shape the attack of many synth sounds.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_mod_envelope;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_mod_envelope = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Decay Curve";
            subtext: "Shape of the envelope's decay stage. Exponential is what the SoundFont specification asks for; linear matches XSynth's linear envelope option.";

            MaestroComboBox {
                width: 150px;
                model: ["Exponential", "Linear"];
                current_index: SettingsEditorState.current_config.synth.kestrel_decay_curve;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_decay_curve = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Release Curve";
            subtext: "Shape of the envelope's release stage.";

            MaestroComboBox {
                width: 150px;
                model: ["Exponential", "Linear"];
                current_index: SettingsEditorState.current_config.synth.kestrel_release_curve;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_release_curve = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Release Floor (dB)";
            subtext: "The level under which a releasing voice is considered silent and stopped. Higher values free voices sooner but cut release tails short.";

            MaestroSpinBox {
                width: 150px;
                minimum: -160;
                maximum: -20;
                step: 1;
                decimals: 1;
                value: SettingsEditorState.current_config.synth.kestrel_release_floor_db;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_release_floor_db = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Layers per Note";
            subtext: "The most voices one note may start. Each SoundFont layer is one voice and a stereo sample is two; this caps runaway presets.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 255;
                value: SettingsEditorState.current_config.synth.kestrel_max_layers;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_max_layers = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Sound Controller Steps";
            subtext: "How many different settings the sound controllers (CC71 to CC75) can sweep through. Each one is a copy of the SoundFont's parameters in memory; past the limit a channel reuses the closest one.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 63;
                value: SettingsEditorState.current_config.synth.kestrel_param_variants;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_param_variants = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Smooth Volume Changes";
            subtext: "Ramps channel volume and expression changes over a fraction of a millisecond instead of stepping them, which avoids clicks on abrupt CC7 or CC11 moves.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_gain_ramp;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_gain_ramp = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Smooth Filter Changes";
            subtext: "Ramps filter changes from CC71 and CC74 instead of switching them, which avoids the filter ringing on abrupt moves.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_filter_ramp;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_filter_ramp = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): SectionCard {
        title: "Voice Management";

        Setting {
            text: "Steal Rule";
            subtext: "Which voices make room when the pool is full. Quietest stops the ones contributing least to the mix, Oldest stops the ones that started first, and Drop New refuses the new note instead.";

            MaestroComboBox {
                width: 150px;
                model: ["Quietest", "Oldest", "Drop New"];
                current_index: SettingsEditorState.current_config.synth.kestrel_steal_rule;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_steal_rule = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Admission Rule";
            subtext: "Which new notes start when a block has more of them than the pool has room for. Loudest keeps the most audible ones; Even thins them out evenly regardless of what they are.";

            MaestroComboBox {
                width: 150px;
                model: ["Loudest", "Even"];
                current_index: SettingsEditorState.current_config.synth.kestrel_admit_rule;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_admit_rule = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Steal Fade (frames)";
            subtext: "How long a stolen voice fades out for instead of being cut. Must be shorter than the block size.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 8191;
                value: SettingsEditorState.current_config.synth.kestrel_steal_fade_frames;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_steal_fade_frames = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): SectionCard {
        title: "Sample Memory";

        Setting {
            text: "Resample Samples on Load";
            subtext: "Converts every sample to the output rate when the SoundFont loads. Off keeps the original rates and resamples while playing instead.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_resample_pool;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_resample_pool = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Sample Memory Budget (MiB)";
            subtext: "The most video memory the SoundFont's samples may take. A SoundFont over it is loaded at half the sample rate, and again until it fits. 0 sizes it from the GPU: three quarters of its video memory, at least 2048 MiB.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 65536;
                value: SettingsEditorState.current_config.synth.kestrel_pool_budget_mib;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_pool_budget_mib = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): SectionCard {
        title: "Performance";

        Setting {
            text: "Block Size";
            subtext: "How many frames Kestrel sends to the GPU at a time, in steps of 32. Larger blocks render faster but take longer each, so keep this small for live playback and raise it to 4096 for converting files, which then renders several times faster. When the render buffer is not a whole number of blocks, the output is delayed by one block.";

            MaestroSpinBox {
                width: 150px;
                minimum: 128;
                maximum: 8192;
                step: 32;
                value: SettingsEditorState.current_config.synth.kestrel_block_frames;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_block_frames = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Gate Resolution (frames)";
            subtext: "How often note-offs, channel controllers and LFOs are updated on the GPU. Smaller is more precise but slower.";

            MaestroComboBox {
                width: 150px;
                model: ["4", "8", "16", "32"];
                current_index: SettingsEditorState.current_config.synth.kestrel_gate_frames;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_gate_frames = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Workgroup Size";
            subtext: "GPU threads per render workgroup. 256 measured fastest on current cards.";

            MaestroComboBox {
                width: 150px;
                model: ["32", "64", "128", "256", "512", "1024"];
                current_index: SettingsEditorState.current_config.synth.kestrel_workgroup_size;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_workgroup_size = i;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Render Workgroups";
            subtext: "The most workgroups one render pass dispatches; voices past that are looped over. More can be faster but takes more video memory.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 65535;
                value: SettingsEditorState.current_config.synth.kestrel_render_workgroups;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_render_workgroups = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Voices per Submission";
            subtext: "The most voices one piece of GPU work renders before a block is split. Windows resets the graphics driver when one piece runs over 2 seconds; Kestrel lowers this by itself when a part runs long.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 16777216;
                value: SettingsEditorState.current_config.synth.kestrel_submit_voices;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_submit_voices = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Voice Building Threads";
            subtext: "CPU threads that prepare each block's new voices while the GPU waits for them.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 64;
                value: SettingsEditorState.current_config.synth.kestrel_build_threads;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_build_threads = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Sort Voices";
            subtext: "Keeps the voice pool sorted so voices reading the same samples run together. By far the biggest speedup in Kestrel; turn off only to measure it.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_sort_voices;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_sort_voices = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Compensated Summation";
            subtext: "Mixes voices with Kahan summation for slightly lower rounding error, at some cost in speed.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_kahan_reduce;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_kahan_reduce = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Unchecked Shaders";
            subtext: "Compiles the GPU shaders without bounds checks. Somewhat faster, but a bug becomes a GPU memory error instead of a harmless one.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.kestrel_unchecked_shaders;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kestrel_unchecked_shaders = v;
                    root.commit();
                }
            }
        }
    }
}

// Synthesizer picker plus the parameter panel of whichever backend is active.
// Adding a synth means adding a `SynthKind` variant, one entry in `SYNTHS`
// (slint_conv.rs) and one panel below.
export component SynthSection inherits MaestroCard {
    in property <bool> show_advanced: false;

    property <SlintSynthConfig> edit;

    property <SynthKind> kind: SettingsEditorState.current_config.synth.kind;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 24px;
            cross-axis-alignment: center;

            TitleText {
                text: "Synthezizer";
            }

            VerticalSeparator { }

            MaestroSynthComboBox {
                width: 260px;
                items: SettingsEditorState.synth_options;
                current_index: SettingsEditorState.synth_index;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kind = SettingsEditorState.synth_kinds[i];
                    SettingsEditorState.update_synth(root.edit);
                }
            }
        }

        if (root.kind == SynthKind.fluidsynth): FluidSynthPanel {
            show_advanced: root.show_advanced;
        }
        if (root.kind == SynthKind.bassmidi): BassMidiPanel {
            show_advanced: root.show_advanced;
        }
        if (root.kind == SynthKind.svms): SVMSPanel {
            show_advanced: root.show_advanced;
        }
        if (root.kind == SynthKind.kestrel): KestrelPanel {
            show_advanced: root.show_advanced;
        }
    }
}
