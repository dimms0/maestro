import {
    Theme,
    MaestroCard,
    MaestroCheckBox,
    MaestroComboBox,
    MaestroSpinBox,
    MaestroLineEdit,
    MaestroSynthComboBox,
    HorizontalSeparator,
    VerticalSeparator,
    TitleText,
    BodyText,
    LabelText,
    MaestroSwitch,
    Setting,
} from "../../widgets.slint";
import { SettingsEditorState } from "../../globals.slint";
import { SynthKind } from "../../enums.slint";
import { SlintSynthConfig, SlintComboItem } from "../../structs.slint";

// Base for the per-synth panels: gives each one the scratch copy it edits and a
// single `commit()` so no panel repeats the update plumbing.
//
// The scratch is refreshed from the authoritative config on every commit, so an
// external change (Discard, switching component) can never be undone by a later
// edit re-sending stale values.
component SynthPanel inherits VerticalLayout {
    in-out property <SlintSynthConfig> edit;
    spacing: 12px;

    public function commit() {
        SettingsEditorState.update_synth(root.edit);
    }

    @children
}

component FluidSynthPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    // Keeps the multi-core group on screen whenever it is actually doing
    // something, so a setting that is in effect is never hidden behind the
    // advanced toggle. One core is the default (single-threaded rendering).
    property <bool> multicore_set: SettingsEditorState.current_config.synth.fluid_cpu_cores > 1;

    edit: SettingsEditorState.current_config.synth;

    TitleText {
        text: "General";
    }

    Setting {
        text: "Polyphony";
        subtext: "The polyphony defines how many voices can be played in parallel. A note event produces one or more voices. Its good to set this to a value which the system can handle and will thus limit FluidSynth's CPU usage. When FluidSynth runs out of voices it will begin terminating lower priority voices for new note events.";

        MaestroSpinBox {
            width: 150px;
            minimum: 1;
            maximum: 65535;
            value: SettingsEditorState.current_config.synth.fluid_voice_limit;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_voice_limit = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Interpolation Method";
        subtext: "Sets the default interpolation method, used to resample the SoundFont's samples to the notes being played. Higher orders sound cleaner (less aliasing) at the cost of CPU time.";

        MaestroComboBox {
            width: 150px;
            model: ["None", "Linear", "Sinc 4th Order", "Sinc 7th Order"];
            current_index: SettingsEditorState.current_config.synth.fluid_interpolation;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_interpolation = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "MIDI Bank Select";
        subtext: "How bank select messages (CC0 / CC32) are interpreted. \"GS\" uses CC0 as the bank, \"XG\" uses CC32 and reserves CC0 values 120, 126 and 127 for drum kits, \"GM\" ignores bank selects entirely, and \"MMA\" combines both controllers into one bank number (CC0 * 128 + CC32).";

        MaestroComboBox {
            width: 150px;
            model: ["GS", "GM", "GM2", "XG", "MMA"];
            current_index: SettingsEditorState.current_config.synth.fluid_midi_bank_select;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_midi_bank_select = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "Portamento Time";
        subtext: "How the portamento time controller (CC5) is converted to a duration. \"Automatic\" follows whichever MIDI standard the file identifies itself as, \"Linear\" maps the controller straight onto milliseconds, and \"XG / GS\" uses the curve those standards define.";

        MaestroComboBox {
            width: 150px;
            model: ["Automatic", "Linear", "XG / GS"];
            current_index: SettingsEditorState.current_config.synth.fluid_portamento_time;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_portamento_time = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "Minimum Note Length (ms)";
        subtext: "Sets the minimum note duration in milliseconds. This ensures that really short duration note events, such as percussion notes, have a better chance of sounding as intended. Set to 0 to disable this feature.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 65535;
            value: SettingsEditorState.current_config.synth.fluid_min_note_length;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_min_note_length = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Device ID";
        subtext: "Device identifier used for SYSEX commands, such as MIDI Tuning Standard commands. Fluidsynth will only process those SYSEX commands destined for this ID (except when this setting is set to 127, which causes fluidsynth to process all SYSEX commands, regardless of the device ID). Broadcast commands (with ID=127) will always be processed. It has been observed that setting this ID to 16 provides best compatibility when playing MIDI files which contain SYSEX commands that you want to have honored.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 127;
            value: SettingsEditorState.current_config.synth.fluid_system_id;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_system_id = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Repeated Note Handling";
        subtext: "What happens when a note-on arrives for a key that is already sounding on the same channel: the notes can be left to overlap, or the older voice can be released (letting its volume envelope fade out) or cut off at once.";

        MaestroComboBox {
            width: 150px;
            model: ["Overlap", "Release Previous", "Cut Previous"];
            current_index: SettingsEditorState.current_config.synth.fluid_note_cut;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_note_cut = i;
                root.commit();
            }
        }
    }

    Rectangle { }

    TitleText {
        text: "Chorus";
    }

    Setting {
        text: "Enable Chorus";
        subtext: "When enabled the chorus effects module is activated. Otherwise, no chorus will be added to the output signal. The amount of signal sent to the chorus module depends on the \"chorus send\" generator defined in the SoundFont.";

        MaestroSwitch {
            checked: SettingsEditorState.current_config.synth.fluid_chorus;
            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_chorus = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Depth";
        subtext: "Specifies the modulation depth of the chorus.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 256;
            step: 0.25;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_chorus;
            value: SettingsEditorState.current_config.synth.fluid_chorus_depth;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_chorus_depth = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Level";
        subtext: "Specifies the output amplitude of the chorus signal.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 10;
            step: 0.1;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_chorus;
            value: SettingsEditorState.current_config.synth.fluid_chorus_level;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_chorus_level = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Speed";
        subtext: "Sets the modulation speed in Hz.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0.1;
            maximum: 5;
            step: 0.1;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_chorus;
            value: SettingsEditorState.current_config.synth.fluid_chorus_speed;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_chorus_speed = v;
                root.commit();
            }
        }
    }

    Rectangle { }

    TitleText {
        text: "Reverb";
    }

    Setting {
        text: "Enable Reverb";
        subtext: "When enabled the reverb effects module is activated. Otherwise, no reverb will be added to the output signal. The amount of signal sent to the reverb module depends on the \"reverb send\" generator defined in the SoundFont.";

        MaestroSwitch {
            checked: SettingsEditorState.current_config.synth.fluid_reverb;
            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Reverb Engine";
        subtext: "The algorithm that produces the reverb. More information at https://www.fluidsynth.org/wiki/reverbators/";

        MaestroComboBox {
            width: 150px;
            model: ["Freeverb", "FDN", "Lexverb", "Dattorro", "Signalsmith"];
            enabled: SettingsEditorState.current_config.synth.fluid_reverb;
            current_index: SettingsEditorState.current_config.synth.fluid_reverb_engine;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb_engine = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "Room Size";
        subtext: "Sets the room size (i.e. decay duration of wet) reverb.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 1;
            step: 0.05;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_reverb;
            value: SettingsEditorState.current_config.synth.fluid_reverb_roomsize;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb_roomsize = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Damping";
        subtext: "Sets how much the high frequencies are damped as the reverb decays. Higher values make the tail darker and shorter.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 1;
            step: 0.05;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_reverb;
            value: SettingsEditorState.current_config.synth.fluid_reverb_damp;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb_damp = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Width";
        subtext: "Sets the stereo spread of the reverb signal, i.e. how much the wet-left signal contributes to the wet-right signal and vice versa. A value of 0 indicates no stereo-spread causing the reverb to sound like a monophonic signal. A value of 1 indicates maximum spread between the uncorrelated left and right channels. This subrange [0;1] is recommended for general usage. Values bigger than 1 increase (or exaggerate) the perception of the uncorrelated left and right signals.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 100;
            step: 1;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_reverb;
            value: SettingsEditorState.current_config.synth.fluid_reverb_width;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb_width = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Level";
        subtext: "Specifies the output amplitude of the reverb signal.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 1;
            step: 0.05;
            decimals: 2;
            enabled: SettingsEditorState.current_config.synth.fluid_reverb;
            value: SettingsEditorState.current_config.synth.fluid_reverb_level;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.fluid_reverb_level = v;
                root.commit();
            }
        }
    }

    if (root.show_advanced || root.multicore_set): VerticalLayout {
        spacing: 12px;

        Rectangle { }

        TitleText {
            text: "Multi-Threading";
        }

        Setting {
            text: "CPU Cores";
            subtext: "Sets the number of synthesis CPU cores. If set to a value greater than 1, additional synthesis threads will be created to do the actual rendering work that is then returned synchronously by the render function. This has the affect of utilizing more of the total CPU for voices or decreasing render times when synthesizing audio. So for example, if you set cpu-cores to 4, fluidsynth will attempt to split the synthesis work it needs to do between the client's calling thread and three additional (internal) worker threads. As soon as all threads have done their work, their results are collected and the resulting buffer is returned to the caller.";

            MaestroSpinBox {
                width: 150px;
                minimum: 1;
                maximum: 256;
                value: SettingsEditorState.current_config.synth.fluid_cpu_cores;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_cpu_cores = v;
                    root.commit();
                }
            }
        }
    }

    if (root.show_advanced): VerticalLayout {
        spacing: 12px;

        Rectangle { }

        TitleText {
            text: "Voice Killing from Overflow Score";
        }

        Setting {
            text: "According to Age";
            subtext: "This score is divided by the number of seconds this voice has been active and is added to the overflow priority. It is usually a positive value and gives voices which have just been started a higher priority, making them less likely to be killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_age;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_age = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Percussion";
            subtext: "Sets the overflow priority score added to voices on a percussion channel. This is usually a positive score, to give percussion voices a higher priority and less chance of being killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_percussion;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_percussion = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Released State";
            subtext: "Sets the overflow priority score added to voices that have already received a note-off event. This is usually a negative score, to give released voices a lower priority so that they are killed first in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_released;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_released = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Sustained Notes";
            subtext: "Sets the overflow priority score added to voices that are currently sustained. With the default value, sustained voices are considered less important and are more likely to be killed in an overflow situation.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_sustained;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_sustained = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Volume Multiplier";
            subtext: "Sets the overflow priority score added to voices based on their current volume. The voice volume is normalized to a value between 0 and 1 and multiplied with this setting. So voices with maximum volume get added the full score, voices with only half that volume get added half of this score.";

            MaestroSpinBox {
                width: 150px;
                minimum: -10000;
                maximum: 10000;
                step: 10;
                value: SettingsEditorState.current_config.synth.fluid_overflow_volume;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.fluid_overflow_volume = v;
                    root.commit();
                }
            }
        }
    }
}

component BassMidiPanel inherits SynthPanel {
    in property <bool> show_advanced: false;

    // Keeps the SoundFont group on screen when any of its flags is set, so a
    // setting that is actually in effect is never hidden behind the advanced
    // toggle. All seven default to false.
    property <bool> sf_options_set:
        SettingsEditorState.current_config.synth.bass_sf_linear_attack_mod
        || SettingsEditorState.current_config.synth.bass_sf_linear_decay_vol
        || SettingsEditorState.current_config.synth.bass_sf_minfx
        || SettingsEditorState.current_config.synth.bass_sf_nofx
        || SettingsEditorState.current_config.synth.bass_sf_no_rampin
        || SettingsEditorState.current_config.synth.bass_sf_sb_limits
        || SettingsEditorState.current_config.synth.bass_sf_xg_drums;

    edit: SettingsEditorState.current_config.synth;

    TitleText {
        text: "General";
    }

    Setting {
        text: "Active Voice Limit";
        subtext: "This is not necessarily the same thing as the maximum number of notes, due to presets possibly containing multiple layered samples, ie. multiple samples may be played for a single note. When the voice limit is hit, the voice with the lowest volume level will be killed.";

        MaestroSpinBox {
            width: 150px;
            minimum: 1;
            maximum: 2147483648;
            value: SettingsEditorState.current_config.synth.bass_voice_limit;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_voice_limit = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Interpolation Method";
        subtext: "The linear interpolation option uses less CPU, but the sinc interpolation gives better sound quality (less aliasing), with the quality and CPU usage increasing with the number of points.";

        MaestroComboBox {
            width: 150px;
            model: ["None", "Linear", "8 Point Sinc", "16 Point Sinc"];
            current_index: SettingsEditorState.current_config.synth.bass_interpolation;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_interpolation = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "Render Time Limit (%)";
        subtext: "How timely the stream is able to render data. When the limit is exceeded, BASSMIDI will begin killing voices, starting with the most quiet. This does not affect MIDI event decoding.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            maximum: 100;
            value: SettingsEditorState.current_config.synth.bass_render_time_limit;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_render_time_limit = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Exclusive Notes";
        subtext: "When enabled, this attribute effectively gives each key its own exclusive class/group. Any keys that are already assigned to an exclusive class/group by the active soundfont are unaffected.";

        MaestroComboBox {
            width: 150px;
            model: ["Disabled", "Only Drums", "All Notes"];
            current_index: SettingsEditorState.current_config.synth.bass_exclusive_keys;
            selected(v, i) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_exclusive_keys = i;
                root.commit();
            }
        }
    }

    Setting {
        text: "Disable Audio Effects";
        subtext: "Disable reverb and chorus processing, saving some CPU time.";

        MaestroSwitch {
            checked: SettingsEditorState.current_config.synth.bass_disable_effects;
            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_disable_effects = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Killed Note Fading";
        subtext: "Fade out voices when killing them.";

        MaestroSwitch {
            checked: SettingsEditorState.current_config.synth.bass_fade_out_killing;
            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_fade_out_killing = v;
                root.commit();
            }
        }
    }

    Setting {
        text: "Don't Follow Overlaps on Note-Off Events";
        subtext: "Only release the oldest instance upon a note off event when there are overlapping instances of the note. Otherwise all instances are released.";

        MaestroSwitch {
            checked: SettingsEditorState.current_config.synth.bass_note_off1;
            toggled(v) => {
                root.edit = SettingsEditorState.current_config.synth;
                root.edit.bass_note_off1 = v;
                root.commit();
            }
        }
    }

    if (root.show_advanced || SettingsEditorState.current_config.synth.bass_multithreading): VerticalLayout {
        spacing: 12px;

        Rectangle { }

        TitleText {
            text: "Multithreading";
        }

        Setting {
            text: "Enable Multi-Threading";
            subtext: "Multithreading will improve performance on larger MIDIs, although some MIDI features might not always work correctly (portamento, SysEx etc.). Only enable if you know what you are doing.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_multithreading;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_multithreading = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Keyboard Divisions";
            subtext: "Maestro will split the rendering into multiple BASSMIDI instances. Each of the 16 MIDI channels will be split in the given amount of instances. So the number of instances is calculated as such: (16 x keyb.divs.)";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 256;
                value: SettingsEditorState.current_config.synth.bass_keyboard_divisions;
                enabled: SettingsEditorState.current_config.synth.bass_multithreading;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_keyboard_divisions = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Thread Count";
            subtext: "The audio rendering of the various synthesizer instances will be split between this amount of threads. Use 0 for Maestro to automatically determine the number of threads to achieve the best possible performance.";

            MaestroSpinBox {
                width: 150px;
                minimum: 0;
                maximum: 256;
                value: SettingsEditorState.current_config.synth.bass_thread_count;
                enabled: SettingsEditorState.current_config.synth.bass_multithreading;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_thread_count = v;
                    root.commit();
                }
            }
        }

        if (SettingsEditorState.current_config.synth.bass_multithreading): BodyText {
            horizontal-alignment: center;
            text: SettingsEditorState.current_config.synth.bass_keyboard_divisions * 16 + " BASSMIDI instances | Total voice limit: "
                + SettingsEditorState.current_config.synth.bass_voice_limit * SettingsEditorState.current_config.synth.bass_keyboard_divisions * 16;
        }
    }

    if (root.show_advanced || root.sf_options_set): VerticalLayout {
        spacing: 12px;

        Rectangle { }

        TitleText {
            text: "SoundFont Options";
        }

        Setting {
            text: "Use a linear attack phase in SF2 modulation (pitch/filter) envelopes";
            subtext: "Otherwise a convex curve is used. The attack phase is always linear in SFZ envelopes.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_linear_attack_mod;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_linear_attack_mod = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Use linear decay and release phases in volume envelopes";
            subtext: "Otherwise a concave curve is used. The attack phase is always linear.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_linear_decay_vol;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_linear_decay_vol = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Treat the reverb / chorus levels in the SoundFont as minimums";
            subtext: "The higher of them and the MIDI levels (CC91/93) will be used instead of the sum of both.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_minfx;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_minfx = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Ignore the reverb / chorus levels in the SoundFont and only use the MIDI levels";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_nofx;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_nofx = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Never ramp-in the start of a sample in the SoundFont";
            subtext: "Otherwise a sample will be ramped-in if its data does not begin with a 0 (further away results in a longer ramp). This is only relevant when the volume envelope has no attack phase.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_no_rampin;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_no_rampin = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Emulate Creative / SoundBlaster hardware filter and SF2 generator limits";
            subtext: "This flag only applies to SF2 files. If disabled, the emulation will be determined by how the file was created, with it being enabled if the file's \"ISFT\" chunk contains \"SFEDT\" or \"E-mu Systems SoundFont Designer\".";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_sb_limits;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_sb_limits = v;
                    root.commit();
                }
            }
        }

        Setting {
            text: "Use bank 127 in the SoundFont for XG drum kits";
            subtext: "When an XG drum kit is needed, bank 127 in soundfonts will be checked first, before falling back to bank 128 (the standard SF2 drum kit bank) if it is not available there.";

            MaestroSwitch {
                checked: SettingsEditorState.current_config.synth.bass_sf_xg_drums;
                toggled(v) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.bass_sf_xg_drums = v;
                    root.commit();
                }
            }
        }
    }
}

// Synthesizer picker plus the parameter panel of whichever backend is active.
// Adding a synth means adding a `SynthKind` variant, one entry in
// `synth_options` and one panel below.
export component SynthSection inherits MaestroCard {
    in property <bool> show_advanced: false;

    property <SlintSynthConfig> edit;

    // The SoundFont formats each backend can load. Mirrors
    // `SynthLibrary::supported_soundfont_types` — update both together.
    property <[SlintComboItem]> synth_options: [
        { text: "FluidSynth", badge_a: "SF2", badge_b: "SF3" },
        { text: "BASSMIDI", badge_a: "SF2", badge_b: "SF3", badge_c: "SFZ" },
    ];

    property <SynthKind> kind: SettingsEditorState.current_config.synth.kind;
    property <int> kind_index: root.kind == SynthKind.fluidsynth ? 0 : 1;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 24px;
            cross-axis-alignment: center;

            TitleText {
                text: "Synthezizer";
            }

            VerticalSeparator { }

            MaestroSynthComboBox {
                width: 260px;
                items: root.synth_options;
                current_index: root.kind_index;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.synth;
                    root.edit.kind = i == 0 ? SynthKind.fluidsynth : SynthKind.bassmidi;
                    SettingsEditorState.update_synth(root.edit);
                }
            }
        }

        if (root.kind == SynthKind.fluidsynth): FluidSynthPanel {
            show_advanced: root.show_advanced;
        }
        if (root.kind == SynthKind.bassmidi): BassMidiPanel {
            show_advanced: root.show_advanced;
        }
    }
}
