// Component-specific settings panels: shown only for the component that owns
// them, as declared by its profile on the Rust side.
import {
    Theme,
    BodyText,
    MaestroCheckBox,
    MaestroComboBox,
    MaestroLineEdit,
    MaestroButton,
    MaestroMidiModeBox,
    MaestroSpinBox,
    SectionCard,
    Field,
    LabelText,
    MaestroSwitch,
    Icons,
} from "../../widgets.slint";
import { SettingsEditorState } from "../../globals.slint";
import { SlintConverterCustom, SlintSystemCustom } from "../../structs.slint";
import { Setting } from "../../widgets/layout.slint";
import { ConfirmModal } from "../soundfont_editor/modals.slint";

export component ConverterSection inherits SectionCard {
    property <SlintConverterCustom> edit;

    // Which quality control the chosen format actually has. Keep the indices in
    // sync with `slint_conv.rs`: 0 WAV, 1 FLAC, 2 MP3, 3 OGG.
    property <int> format: SettingsEditorState.current_config.converter_custom.output_format;
    property <bool> is_wav: root.format == 0;
    property <bool> is_lossy: root.format == 2 || root.format == 3;

    property <bool> custom_dir: SettingsEditorState.current_config.converter_custom.use_custom_output_dir;
    // Re-checked on every keystroke, since the renderer falls back to the
    // MIDI's own folder for a path that is not a directory.
    property <bool> dir_exists: SettingsEditorState.output_dir_valid(
        SettingsEditorState.current_config.converter_custom.output_path);
    // Scratch for the folder picker's result.
    property <string> picked;

    title: "Converter Options";

    HorizontalLayout {
        spacing: 24px;

        Field {
            label: "Output Format";

            MaestroComboBox {
                width: 200px;
                model: ["WAV", "FLAC", "MP3", "OGG Vorbis"];
                current_index: root.format;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.converter_custom;
                    root.edit.output_format = i;
                    SettingsEditorState.update_converter_custom(root.edit);
                }
            }
        }

        // Only one of these applies to any given format, so the other is
        // hidden rather than left on screen doing nothing.
        if (root.is_wav): Field {
            label: "Bit Depth";

            MaestroComboBox {
                width: 200px;
                model: ["32-bit float", "24-bit integer", "16-bit integer"];
                current_index: SettingsEditorState.current_config.converter_custom.wav_bit_depth;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.converter_custom;
                    root.edit.wav_bit_depth = i;
                    SettingsEditorState.update_converter_custom(root.edit);
                }
            }
        }

        if (root.is_lossy): Field {
            label: "Bitrate";

            MaestroComboBox {
                width: 200px;
                model: SettingsEditorState.bitrates;
                current_index: SettingsEditorState.current_config.converter_custom.bitrate_index;
                selected(v, i) => {
                    root.edit = SettingsEditorState.current_config.converter_custom;
                    root.edit.bitrate_index = i;
                    SettingsEditorState.update_converter_custom(root.edit);
                }
            }
        }

        if (!root.is_wav && !root.is_lossy): Field {
            label: "Bitrate";

            BodyText {
                text: "FLAC is lossless";
                color: Theme.text_secondary;
                font_size: 12px;
                vertical-alignment: center;
                height: 36px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    Setting {
        text: "Multi-threaded queue export";
        subtext: "When enabled, Maestro will render multiple MIDIs simultaneously according to the number of threads set. When set to 0 (automatic), Maestro will create as many threads as the CPU core count. It is not recommended to use this option with BASSMIDI multithreading enabled.";
        has-switch: true;
        checked: SettingsEditorState.current_config.converter_custom.multithreaded_export;
        toggled(v) => {
            root.edit = SettingsEditorState.current_config.converter_custom;
            root.edit.multithreaded_export = v;
            SettingsEditorState.update_converter_custom(root.edit);
        }

        MaestroSpinBox {
            width: 110px;
            minimum: 0;
            maximum: 64;
            value: SettingsEditorState.current_config.converter_custom.export_threads;
            enabled: SettingsEditorState.current_config.converter_custom.multithreaded_export;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.converter_custom;
                root.edit.export_threads = Math.round(v);
                SettingsEditorState.update_converter_custom(root.edit);
            }
        }

        LabelText {
            // 0 hands the choice back to the scheduler, which sizes the pool
            // to the machine.
            text: SettingsEditorState.current_config.converter_custom.export_threads == 0
                ? "threads (auto)"
                : "threads at once";
        }
    }

    Setting {
        text: "Save to a custom output directory";
        subtext: "When disabled, the output audio file will be saved in the same directory as the MIDI file.";
        has-switch: true;
        checked: root.custom_dir;
        toggled(v) => {
            root.edit = SettingsEditorState.current_config.converter_custom;
            root.edit.use_custom_output_dir = v;
            SettingsEditorState.update_converter_custom(root.edit);
        }
    }

    // Hidden while the switch is off: the path is still kept in the config, so
    // turning it back on brings the directory back rather than a blank box.
    if (root.custom_dir): Field {
        label: "Output Directory";

        HorizontalLayout {
            spacing: 8px;

            MaestroLineEdit {
                horizontal-stretch: 1;
                placeholder: "/path/to/output";
                text: SettingsEditorState.current_config.converter_custom.output_path;
                invalid: !root.dir_exists;
                edited(v) => {
                    root.edit = SettingsEditorState.current_config.converter_custom;
                    root.edit.output_path = v;
                    SettingsEditorState.update_converter_custom(root.edit);
                }
            }

            MaestroButton {
                horizontal-stretch: 0;
                text: "Browse…";
                clicked => {
                    root.picked = SettingsEditorState.browse_output_dir();
                    // An empty result means the dialog was dismissed, which
                    // should leave the current path alone.
                    if (root.picked != "") {
                        root.edit = SettingsEditorState.current_config.converter_custom;
                        root.edit.output_path = root.picked;
                        SettingsEditorState.update_converter_custom(root.edit);
                    }
                }
            }
        }
    }

    if (root.custom_dir && !root.dir_exists): BodyText {
        text: "That folder does not exist — audio will be saved next to each MIDI until it does.";
        color: Theme.accent_red;
        font_size: 12px;
        wrap: word-wrap;
    }
}

// The Virtual Device's own fields, shown on its card and in its settings.
export component SystemCustomFields inherits VerticalLayout {
    in property <SlintSystemCustom> custom;
    in property <length> label_font_size: 12px;

    callback changed_custom(SlintSystemCustom);

    // Scratch copy, refreshed from `custom` before every edit, so a Discard
    // can't be undone by a later keystroke re-sending stale values.
    property <SlintSystemCustom> edit;

    spacing: 12px;

    // Field {
    //     label: "Device Name";
    //     label_font_size: root.label_font_size;

    //     MaestroLineEdit {
    //         placeholder: "Maestro";
    //         text: root.custom.device_name;
    //         edited(v) => {
    //             root.edit = root.custom;
    //             root.edit.device_name = v;
    //             root.changed_custom(root.edit);
    //         }
    //     }
    // }

    Field {
        label: "MIDI Mode";
        label_font_size: root.label_font_size;

        // One box, two halves: the port count only applies to the MIDI 1.0
        // half, since a MIDI 2.0 endpoint always carries 16 groups.
        MaestroMidiModeBox {
            midi2_enabled: root.custom.midi2_enabled;
            num_ports: root.custom.num_ports;
            mode_selected(v) => {
                root.edit = root.custom;
                root.edit.midi2_enabled = v;
                root.changed_custom(root.edit);
            }
            ports_edited(v) => {
                root.edit = root.custom;
                root.edit.num_ports = v;
                root.changed_custom(root.edit);
            }
        }
    }

    Setting {
        has-switch: true;
        text: "Unload Maestro after inactivity";
        subtext: "When unloaded, as soon as an app sends a MIDI message, Maestro will load again. No messages are lost.";
        checked: root.custom.has_idle_timeout;
        toggled(v) => {
            root.edit = root.custom;
            root.edit.has_idle_timeout = v;
            root.changed_custom(root.edit);
        }

        HorizontalLayout {
            spacing: 12px;

            MaestroSpinBox {
                max-width: 130px;
                minimum: 1;
                maximum: 1440;
                value: root.custom.idle_timeout_minutes;
                enabled: root.custom.has_idle_timeout;
                edited(v) => {
                    root.edit = root.custom;
                    root.edit.idle_timeout_minutes = Math.round(v);
                    root.changed_custom(root.edit);
                }
            }

            LabelText {
                text: "minutes";
            }
        }
    }
}

export component LinkConfirmModal inherits ConfirmModal {
    in property <string> name;
    in property <bool> use_shared;

    title: root.use_shared ? "Use Custom Settings" : "Use Shared Settings";
    message: root.use_shared
        ? "Give '" + root.name + "' its own settings? It starts with a copy of the shared settings and stops following them."
        : "Use the shared settings for '" + root.name + "'? Its own settings will be deleted.";
    confirm_text: root.use_shared ? "Unlink" : "Link";
}

export component SharedLinkSection inherits SectionCard {
    callback link_clicked();

    title: "Shared Settings";

    BodyText {
        text: SettingsEditorState.current_config.use_shared
            ? "MIDI, synth and audio settings come from Maestro's shared settings."
            : "This has its own MIDI, synth and audio settings.";
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        if (SettingsEditorState.current_config.use_shared): MaestroButton {
            icon: Icons.settings;
            text: "Edit Shared Settings";
            clicked => { SettingsEditorState.open_settings("shared"); }
        }

        MaestroButton {
            icon: SettingsEditorState.current_config.use_shared ? Icons.unlink : Icons.link;
            text: SettingsEditorState.current_config.use_shared ? "Use Custom Settings" : "Use Shared Settings";
            clicked => { root.link_clicked(); }
        }
    }
}

export component DeviceSection inherits SectionCard {
    title: "Virtual MIDI Device";

    SystemCustomFields {
        custom: SettingsEditorState.current_config.system_custom;
        changed_custom(custom) => { SettingsEditorState.update_system_custom(custom); }
    }
}
