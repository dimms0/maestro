export component RealtimeSection inherits SectionCard {
    in property <bool> show_advanced: false;

    property <SlintRealtimeConfig> edit;

    title: "Realtime Engine";

    if (root.show_advanced): Setting {
        text: "Render Buffer Size (ms)";
        subtext: "Different from the audio device buffer setting. Maestro renders the realtime audio irrespective of the audio device/driver. This setting controls the internal render buffer size which is used to render audio from the synthesizer.";

        MaestroSpinBox {
            width: 150px;
            minimum: 0.1;
            maximum: 100.0;
            decimals: 1;
            value: SettingsEditorState.current_config.realtime.render_buffer_ms;

            edited(v) => {
                root.edit = SettingsEditorState.current_config.realtime;
                root.edit.render_buffer_ms = v;
                SettingsEditorState.update_realtime(root.edit);
            }
        }
    }

    Setting {
        text: "Use the high precision event playback clock";
        subtext: "Events will be precisely timed according to the time they were sent to the realtime module and the playback position so they are rendered at their correct position. This is only relevant for MIDI players that send events with accurate timings. This is not perfect as the system's MIDI chain may add latency/overhead.";

        has-switch: true;
        checked: SettingsEditorState.current_config.realtime.precision_playback;
        toggled(v) => {
            root.edit = SettingsEditorState.current_config.realtime;
            root.edit.precision_playback = v;
            SettingsEditorState.update_realtime(root.edit);
        }
    }

    Setting {
        text: "Limit the maximum notes per second (NPS)";
        subtext: "When the limit is reached, Maestro chooses to ignore notes with lower velocities.";

        has-switch: true;
        checked: SettingsEditorState.current_config.realtime.has_max_nps;
        toggled(v) => {
            root.edit = SettingsEditorState.current_config.realtime;
            root.edit.has_max_nps = v;
            SettingsEditorState.update_realtime(root.edit);
        }

        MaestroSpinBox {
            width: 150px;
            minimum: 0;
            value: SettingsEditorState.current_config.realtime.max_nps;
            enabled: SettingsEditorState.current_config.realtime.has_max_nps;
            edited(v) => {
                root.edit = SettingsEditorState.current_config.realtime;
                root.edit.max_nps = v;
                SettingsEditorState.update_realtime(root.edit);
            }
        }
    }
}
