import { ScrollView } from "std-widgets.slint";
import {
    Theme,
    MaestroButton,
    MaestroCard,
    MaestroLineEdit,
    MaestroCheckBox,
    SflistPicker,
    HorizontalSeparator,
    TitleText,
    BodyText,
    LabelText,
    DirtyBadge,
    Field,
    MaestroProgressBar,
    Icons,
    Setting,
    VerticalSeparator,
    MaestroComboBox,
} from "../widgets.slint";
import {
    DeviceManagerState,
    SettingsEditorState,
    SystemIntegrationState,
} from "../globals.slint";
import { DeviceComponent, IntegrationStatus } from "../enums.slint";
import {
    SlintComponentStats,
    SlintComponentSummary,
} from "../structs.slint";
import { MaestroSwitch } from "../widgets/inputs.slint";
import { SystemCustomFields } from "settings_editor/component.slint";
import { ConfirmModal } from "soundfont_editor/modals.slint";

// One row of the live statistics card: whatever every component reports while
// it is loaded, refreshed continuously from that process's statistics pipe.
component StatsRow inherits MaestroCard {
    in property <SlintComponentStats> stats;

    VerticalLayout {
        spacing: 8px;
        padding: 12px;

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.stats.state == 2 ? Theme.accent_green
                    : root.stats.state == 1 ? Theme.accent_amber
                    : Theme.text_disabled;
            }

            TitleText {
                text: root.stats.name == "" ? "N/A" : root.stats.name;
                color: root.stats.state == 2 ? Theme.text_primary : Theme.text_secondary;
                overflow: elide;
                horizontal-stretch: 1;
            }

            LabelText {
                text: root.stats.memory;
                horizontal-alignment: right;
            }
        }

        BodyText {
            text: root.stats.state == 2 ? "Voice Count: " + root.stats.voices
                : root.stats.state_text;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if (root.stats.state == 2): VerticalLayout {
            spacing: 8px;

            BodyText {
                text: "Notes/s: " + root.stats.nps;
                horizontal-stretch: 1;
            }

            BodyText {
                text: "Events/s: " + root.stats.eps;
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: 12px;

            BodyText {
                text: "Load: ";
            }

            MaestroProgressBar {
                progress: Math.round(root.stats.render_load) / 100.0;
                warn-after: 0.85;
            }

            LabelText {
                horizontal-alignment: right;
                overflow: TextOverflow.elide;
                text: root.stats.render_load_txt;
            }
        }
    }
}

// The SoundFont list picker shown on every device card.
component SflistField inherits Field {
    in property <DeviceComponent> component;
    in property <int> index;

    label: "SoundFont List";
    label_font_size: 13px;

    SflistPicker {
        current_index: root.index;
        selected(v) => { DeviceManagerState.set_sflist(root.component, v); }
    }
}

// Unlinks a component that follows the shared settings. Once it has its own, this
// links it back and opens them.
component ComponentSettingsActions inherits HorizontalLayout {
    in property <SlintComponentSummary> summary;
    in property <string> settings_text: "Settings";
    in property <bool> disabled: false;

    callback link_clicked();

    spacing: 8px;

    MaestroButton {
        horizontal-stretch: 0;
        icon: root.summary.use_shared ? Icons.unlink : Icons.link;
        disabled: root.disabled;
        clicked => { root.link_clicked(); }
    }

    if (!root.summary.use_shared): MaestroButton {
        horizontal-stretch: 0;
        icon: Icons.settings;
        text: root.settings_text;
        disabled: root.disabled;
        clicked => { SettingsEditorState.open_settings(root.summary.config); }
    }
}

// One application on the Per-App card. Its edits save immediately, which keeps
// it small enough for a long list of applications.
component ApiAppCard inherits MaestroCard {
    in property <SlintComponentSummary> app;
    in property <length> card_width;

    callback link_clicked();
    callback remove_clicked();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            Setting {
                text: root.app.name;
                has-switch: true;
                checked: root.app.enabled;
                toggled(v) => { DeviceManagerState.set_app_enabled(root.app.config, v); }
            }

            ComponentSettingsActions {
                horizontal-stretch: 0;
                summary: root.app;
                link_clicked => { root.link_clicked(); }
            }

            MaestroButton {
                horizontal-stretch: 0;
                icon: Icons.trash;
                danger: true;
                clicked => { root.remove_clicked(); }
            }
        }

        SflistPicker {
            horizontal-stretch: 0;
            current_index: root.app.sflist_index;
            selected(v) => { DeviceManagerState.set_app_sflist(root.app.config, v); }
        }
    }
}

// A configurable component of the virtual-device stack. Both cards on this tab
// are instances of this, so enabling, saving, discarding and opening the full
// settings editor behave identically for each; component-specific fields are
// passed in as children.
component DeviceComponentCard inherits MaestroCard {
    in property <DeviceComponent> component;
    in property <SlintComponentSummary> summary;
    in property <string> title;
    in property <string> settings_text;
    in property <string> enable_text;
    // Only components that keep local form state need a Discard button.
    in property <bool> discardable: false;
    in property <bool> saveable: true;

    in property <bool> enabled: true;
    in property <string> disabled_text;

    // The switch means different things per component: for the virtual device
    // it starts and stops a separate process, for KDMAPI it edits a config flag
    // that only takes effect on Save. Where it means neither — the WinMM driver
    // on Windows, which is simply on once registered — it is not shown.
    in property <bool> switch_visible: true;
    in property <bool> switch_on;
    in property <bool> switch_busy: false;
    in property <string> switch_detail;

    callback switch_toggled(bool);
    callback discarded();
    callback link_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        HorizontalLayout {
            alignment: space-between;
            height: 36px;

            TitleText {
                text: root.title;
            }

            if (root.settings_text != ""): ComponentSettingsActions {
                summary: root.summary;
                settings_text: root.settings_text;
                disabled: !root.enabled;
                link_clicked => { root.link_clicked(); }
            }
        }

        if (root.switch_visible && root.enabled): VerticalLayout {
            spacing: 4px;

            MaestroSwitch {
                text: root.enable_text;
                checked: root.switch_on;
                enabled: !root.switch_busy;
                toggled(v) => { root.switch_toggled(v); }
            }

            if (root.switch_detail != ""): LabelText {
                text: root.switch_detail;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        if (!root.enabled): BodyText {
            text: root.disabled_text;
            wrap: word-wrap;
        }

        Rectangle {
            height: root.enabled ? self.preferred-height : 0px;
            clip: true;

            VerticalLayout {
                spacing: 20px;

                @children
            }
        }

        if (root.saveable): Rectangle {
            vertical-stretch: 1;
        }

        if (root.saveable): HorizontalLayout {
            alignment: end;
            spacing: 12px;
            vertical-stretch: 0;

            if (root.summary.dirty): DirtyBadge {
                font-size: 13px;
            }

            if (root.discardable): MaestroButton {
                text: "Discard";
                disabled: !root.summary.dirty || !root.enabled;
                clicked => { root.discarded(); }
            }

            if (root.saveable): MaestroButton {
                text: "Save";
                primary: true;
                disabled: !root.summary.dirty || !root.enabled;
                clicked => { DeviceManagerState.save(root.component); }
            }
        }
    }
}

export component DeviceManagerView inherits Rectangle {
    background: Theme.bg_main;

    property <string> remove_app_config;
    property <string> remove_app_name;
    // The component awaiting confirmation to be unlinked or linked back.
    property <SlintComponentSummary> link_target;

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 20px;
            alignment: start;
            cross-axis-alignment: center;

            // HorizontalLayout {
            //     spacing: 16px;
            //     cross-axis-alignment: center;

            //     TitleText {
            //         overflow: TextOverflow.clip;
            //         text: "Virtual MIDI Device";
            //         font-size: 24px;
            //         font-weight: 800;
            //     }

            //     HorizontalSeparator { }

            //     LabelText {
            //         text: "Configure and manage the system-wide virtual MIDI device";
            //         wrap: TextWrap.word-wrap;
            //         font-size: 14px;
            //     }
            // }

            VerticalLayout {
                spacing: 16px;

                MaestroCard {
                    width: Math.min(root.width, 1000px) - 48px;

                    HorizontalLayout {
                        // alignment: space-between;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;
                        cross-axis-alignment: center;

                        TitleText {
                            horizontal-stretch: 0;
                            width: 140px;
                            text: "Shared Settings";
                        }

                        LabelText {
                            horizontal-stretch: 0;
                            text: DeviceManagerState.shared_users == ""
                                ? "Nothing is using the shared settings."
                                : "Used by: " + DeviceManagerState.shared_users;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        MaestroButton {
                            width: 190px;
                            horizontal-stretch: 0;
                            icon: Icons.settings;
                            text: "Edit Shared Settings";
                            clicked => { SettingsEditorState.open_settings("shared"); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    DeviceComponentCard {
                        width: Math.min(root.width, 1000px) * 0.6 - 32px;

                        component: DeviceComponent.system;
                        summary: DeviceManagerState.system;
                        title: "Virtual Device";
                        settings_text: "Device Settings";
                        enable_text: "Start / Stop the Virtual Device";
                        discardable: true;
                        discarded => { DeviceManagerState.discard(DeviceComponent.system); }
                        link_clicked => { root.link_target = DeviceManagerState.system; }

                        // On Windows the WinMM driver is on once registered and
                        // there is nothing to switch; the System Integration
                        // tab handles installing and repairing it instead.
                        switch_visible: !SystemIntegrationState.windows;
                        switch_on: DeviceManagerState.daemon_running;
                        switch_busy: DeviceManagerState.daemon_busy;
                        switch_detail: DeviceManagerState.daemon_state == 1
                            ? "Starting — loading soundfonts…"
                            : DeviceManagerState.daemon_state == 3
                            ? "Paused after a quiet spell. Playing anything wakes it up."
                            : DeviceManagerState.daemon_running
                            ? "Using " + DeviceManagerState.daemon_memory
                            + ". Maestro keeps running after you close this window."
                            : "Devices appear in your other applications while this is on.";
                        switch_toggled(v) => { DeviceManagerState.set_running(v); }

                        if (!SystemIntegrationState.windows): MaestroCheckBox {
                            text: "Start automatically when Maestro opens";
                            checked: DeviceManagerState.start_on_launch;
                            toggled(v) => { DeviceManagerState.set_start_on_launch(v); }
                        }

                        SflistField {
                            component: DeviceComponent.system;
                            index: DeviceManagerState.system.sflist_index;
                        }

                        SystemCustomFields {
                            spacing: 20px;
                            label_font_size: 13px;
                            custom: DeviceManagerState.system_custom;
                            changed_custom(custom) => { DeviceManagerState.update_system_custom(custom); }
                        }
                    }

                    MaestroCard {
                        width: Math.min(root.width, 1000px) * 0.4 - 32px;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 20px;

                            TitleText {
                                text: "Active Instances";
                            }

                            if (DeviceManagerState.stats.length == 0): LabelText {
                                text: "No active Maestro instances.";
                                font-size: 13px;
                            }

                            ScrollView {
                                VerticalLayout {
                                    spacing: 12px;

                                    for entry in DeviceManagerState.stats: StatsRow {
                                        stats: entry;
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    DeviceComponentCard {
                        width: Math.min(root.width, 1000px) * 0.4 - 32px;

                        enabled: SystemIntegrationState.kdmapi.status == IntegrationStatus.ok;
                        disabled_text: "The KDMAPI bridge is not installed. Go to the System Integration tab to repair.";
                        component: DeviceComponent.kdmapi;
                        summary: DeviceManagerState.kdmapi;
                        title: "KDMAPI";
                        settings_text: "KDMAPI Settings";
                        enable_text: "Allow applications to use KDMAPI";
                        switch_on: DeviceManagerState.kdmapi.enabled;
                        switch_toggled(v) => {
                            DeviceManagerState.set_enabled(DeviceComponent.kdmapi, v);
                        }
                        link_clicked => { root.link_target = DeviceManagerState.kdmapi; }

                        SflistField {
                            component: DeviceComponent.kdmapi;
                            index: DeviceManagerState.kdmapi.sflist_index;
                        }
                    }

                    DeviceComponentCard {
                        width: Math.min(root.width, 1000px) * 0.6 - 32px;

                        enabled: SystemIntegrationState.api.status == IntegrationStatus.ok;
                        disabled_text: "The Maestro API is not installed. Go to the System Integration tab to install it.";
                        title: "Maestro API Applications";
                        settings_text: "";
                        switch_visible: false;
                        saveable: false;

                        if (DeviceManagerState.api_apps.length == 0): LabelText {
                            text: "Applications that use Maestro API appear here once they connect. Each starts from the shared settings.";
                            wrap: word-wrap;
                        }

                        ScrollView {
                            height: 250px;

                            VerticalLayout {
                                spacing: 12px;

                                for app in DeviceManagerState.api_apps: ApiAppCard {
                                    app: app;
                                    // card_width: label.width;
                                    link_clicked => { root.link_target = app; }
                                    remove_clicked => {
                                        root.remove_app_config = app.config;
                                        root.remove_app_name = app.name;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (root.remove_app_config != ""): ConfirmModal {
        title: "Remove Application Settings";
        message: "Remove the settings of '" + root.remove_app_name + "'? It will start again on the shared settings the next time it connects.";
        confirm_text: "Remove";
        dismissed => { root.remove_app_config = ""; }
        confirmed => { DeviceManagerState.remove_app_config(root.remove_app_config); }
    }

    if (root.link_target.config != ""): ConfirmModal {
        title: root.link_target.use_shared ? "Use Custom Settings" : "Use Shared Settings";
        message: root.link_target.use_shared
            ? "Give '" + root.link_target.name + "' its own settings? It starts with a copy of the shared settings and stops following them."
            : "Use the shared settings for '" + root.link_target.name + "'? Its own settings will be deleted.";
        confirm_text: root.link_target.use_shared ? "Unlink" : "Link";
        dismissed => { root.link_target.config = ""; }
        confirmed => {
            DeviceManagerState.set_use_shared(root.link_target.config, !root.link_target.use_shared);
        }
    }
}
