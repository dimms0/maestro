import { ModalOverlay, ModalActions } from "../widgets/layout.slint";
import { LabelText } from "../widgets/text.slint";
import { MaestroButton } from "../widgets/controls.slint";
import { AppState, RendererState } from "../globals.slint";

// The three prompts the close-request gate can raise, one per `QuitStage`.
//
// None of them is dismissable by clicking the backdrop: the whole point is that
// closing the window stops being something that happens by accident, so the
// user has to pick one of the offered outcomes. Every outcome ends in a Rust
// callback rather than in a local `hide()`, because only Rust knows whether
// answering one question uncovers another.

// Shown when a conversion run is still going.
export component RenderQuitModal inherits ModalOverlay {
    title: "Rendering in progress";
    card_width: 460px;
    card_height: 220px;
    content_spacing: 16px;
    dismissable: false;

    LabelText {
        text: AppState.quit_prompt_detail;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: top;
    }

    ModalActions {
        // Cancelling is not revocable once requested, so while the workers wind
        // down the only thing left to do is wait: the window closes by itself
        // (or moves on to the next question) as soon as they stop.
        if (!RendererState.is_cancelling): MaestroButton {
            text: "Keep Rendering";
            primary: true;
            clicked => { AppState.cancel_quit(); }
        }

        MaestroButton {
            text: RendererState.is_cancelling ? "Cancelling…" : "Cancel Render & Quit";
            danger: true;
            disabled: RendererState.is_cancelling;
            clicked => { AppState.cancel_render_and_quit(); }
        }
    }
}

// Shown when an editor holds edits that were never written to disk.
export component UnsavedQuitModal inherits ModalOverlay {
    title: "Unsaved changes";
    card_width: 480px;
    card_height: 260px;
    content_spacing: 16px;
    dismissable: false;

    LabelText {
        text: AppState.quit_prompt_detail;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: top;
    }

    ModalActions {
        MaestroButton {
            text: "Cancel";
            clicked => { AppState.cancel_quit(); }
        }

        MaestroButton {
            text: "Discard & Quit";
            danger: true;
            clicked => { AppState.discard_and_quit(); }
        }

        MaestroButton {
            text: "Save & Quit";
            primary: true;
            clicked => { AppState.save_and_quit(); }
        }
    }
}

// Shown when the window is closed with the daemon still running.
export component QuitConfirmModal inherits ModalOverlay {
    title: "Maestro is still running";
    card_width: 460px;
    card_height: 220px;
    content_spacing: 16px;
    dismissable: false;

    LabelText {
        text: AppState.quit_prompt_detail;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: top;
    }

    ModalActions {
        // Stopping the daemon is not instant, and the prompt stays up until it
        // is done: the remaining buttons go away rather than letting a second
        // answer land on top of the one already running.
        if (!AppState.quit_busy): MaestroButton {
            text: "Cancel";
            clicked => { AppState.cancel_quit(); }
        }

        MaestroButton {
            text: AppState.quit_busy ? "Stopping…" : "Stop and quit";
            danger: true;
            disabled: AppState.quit_busy;
            clicked => { AppState.quit_and_stop(); }
        }

        if (!AppState.quit_busy): MaestroButton {
            text: "Keep running";
            primary: true;
            clicked => { AppState.quit_keep_running(); }
        }
    }
}
