import { ScrollView } from "std-widgets.slint";
import {
    Theme,
    MaestroButton,
    MaestroIconButton,
    MaestroCard,
    MaestroCheckBox,
    MaestroMarqueeText,
    MaestroSfTypeBadge,
    TitleText,
    LabelText,
    Icons,
    MaestroIcon,
} from "../../widgets.slint";
import { SoundfontEditorState } from "../../globals.slint";

// The SoundFonts of the selected sub-list, in playback order.
//
// Rows can be reordered by dragging their handle. Reordering swaps the row
// *data* only, so the grabbed handle keeps its screen position (and its pointer
// grab) for the whole gesture: `drag_origin_idx` is the slot that holds the
// grab, `drag_current_idx` the slot the dragged SoundFont has travelled to so
// far, drawn as an empty placeholder.
export component SoundFontTable inherits MaestroCard {
    // Opens the bank/preset dialog for a newly picked file (SFZ only).
    callback add_requested(string, string); // (path, sf_type)
    // Opens the bank/preset dialog for an existing row.
    callback edit_requested(int, bool, string, string, int, int); // (index, enabled, path, sf_type, bank, preset)

    property <int> drag_origin_idx: -1;
    property <int> drag_current_idx: -1;
    property <length> row_pitch: 56px; // 48px row height + 8px list spacing

    // Scratch state for the file picker, which cannot return into a local.
    property <string> picked_path;
    property <string> picked_type;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;

            TitleText {
                text: "SoundFonts in '"
                    + SoundfontEditorState.available_sublists[SoundfontEditorState.selected_sublist_index]
                    + "'";
                font-size: 15px;
            }

            MaestroButton {
                icon: Icons.plus;
                text: "Add SoundFont";
                primary: true;
                clicked => {
                    root.picked_path = SoundfontEditorState.browse_soundfont();
                    if (root.picked_path != "") {
                        root.picked_type = SoundfontEditorState.soundfont_type(root.picked_path);
                        // Only SFZ needs a bank/preset before it can be added;
                        // SF2/SF3 go straight in with "all presets".
                        if (root.picked_type == "SFZ") {
                            root.add_requested(root.picked_path, root.picked_type);
                        } else {
                            SoundfontEditorState.add_soundfont(root.picked_path, 0, -1);
                        }
                        root.picked_path = "";
                        root.picked_type = "";
                    }
                }
            }
        }

        ScrollView {
            if (SoundfontEditorState.current_soundfonts.length == 0): Rectangle {
                height: 100px;
                LabelText {
                    text: "Sub-list is empty. Add SoundFonts by dropping or using the button above.";
                    overflow: elide;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 8px;

                for sf[sfidx] in SoundfontEditorState.current_soundfonts: row := Rectangle {
                    // Slot this row's SoundFont would land in if the drag ended
                    // now. The grabbed handle stays put while the row contents
                    // shift under it, so the travelled distance is absolute:
                    // one row pitch = one slot from the start.
                    property <int> drag_target: Math.max(0, Math.min(
                        SoundfontEditorState.current_soundfonts.length - 1,
                        sfidx + Math.round((drag_handle.mouse-y - drag_handle.pressed-y) / root.row_pitch)));
                    property <bool> is_placeholder: root.drag_current_idx == sfidx;

                    height: 48px;
                    border-radius: 6px;
                    background: Theme.bg_main;
                    border-width: 1px;
                    border-color: self.is_placeholder ? Theme.primary : Theme.border_color;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 8px;

                        // Press and drag to move this SoundFont any number of
                        // slots; it follows the pointer one row at a time as
                        // the pitch threshold is crossed.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;

                            drag_handle := TouchArea {
                                width: 18px;
                                height: 24px;
                                mouse-cursor: root.drag_origin_idx == sfidx ? MouseCursor.grabbing : MouseCursor.grab;

                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        root.drag_origin_idx = sfidx;
                                        root.drag_current_idx = sfidx;
                                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                        root.drag_origin_idx = -1;
                                        root.drag_current_idx = -1;
                                    }
                                }

                                moved => {
                                    if (root.drag_origin_idx == sfidx && root.drag_current_idx >= 0
                                        && row.drag_target != root.drag_current_idx) {
                                        SoundfontEditorState.move_soundfont(root.drag_current_idx, row.drag_target);
                                        root.drag_current_idx = row.drag_target;
                                    }
                                }

                                MaestroIcon {
                                    source: Icons.grip;
                                    colorize: root.drag_origin_idx == sfidx ? Theme.primary : Theme.text_secondary;
                                    size: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Empty drop-slot marker shown where the dragged
                        // SoundFont currently sits.
                        if (row.is_placeholder): VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Rectangle {
                                height: 24px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.primary;
                                background: transparent;
                                opacity: 0.6;
                            }
                        }

                        if (!row.is_placeholder): HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                MaestroCheckBox {
                                    width: 24px;
                                    checked: sf.enabled;
                                    toggled(val) => {
                                        SoundfontEditorState.update_soundfont(sfidx, val, sf.path, sf.bank, sf.preset);
                                    }
                                }
                            }

                            // Format badge + filename; hover the filename to
                            // reveal the full path, scrolled into view and back.
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    MaestroSfTypeBadge {
                                        sf_type: sf.sf_type;
                                    }

                                    MaestroMarqueeText {
                                        horizontal-stretch: 1;
                                        text: sf.filename;
                                        hover_text: sf.path;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 0;

                                LabelText {
                                    text: "Bank" + (sf.preset == -1 ? " off." : "") + ": " + sf.bank;
                                    horizontal-alignment: center;
                                }

                                LabelText {
                                    text: "Preset: " + (sf.preset == -1 ? "All" : sf.preset);
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                cross-axis-alignment: center;
                                horizontal-stretch: 0;
                                spacing: 4px;

                                MaestroIconButton {
                                    width: 24px;
                                    height: parent.height / 2;
                                    icon: Icons.edit;
                                    clicked => {
                                        root.edit_requested(sfidx, sf.enabled, sf.path, sf.sf_type, sf.bank, sf.preset);
                                    }
                                }

                                MaestroIconButton {
                                    width: 24px;
                                    height: parent.height / 2;
                                    icon: Icons.trash;
                                    danger: true;
                                    clicked => { SoundfontEditorState.remove_soundfont(sfidx); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
