import { Theme } from "../theme.slint";
import { MaestroButton, MaestroCard } from "controls.slint";
import { TitleText, LabelText, BodyText } from "text.slint";
import { MaestroSwitch } from "../widgets/inputs.slint";

// A titled card wrapper, for consistent section styling across every editor.
export component SectionCard inherits MaestroCard {
    in property <string> title;
    in property <length> content_spacing: 12px;

    VerticalLayout {
        padding: 16px;
        spacing: root.content_spacing;

        if (root.title != ""): TitleText {
            text: root.title;
        }

        @children
    }
}

// A labelled column: caption above a control. The single way a form field is
// laid out anywhere in the app.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <length> label_font_size: 12px;
    in property <color> label_color: Theme.text_secondary;
    spacing: 6px;

    LabelText {
        text: root.label;
        font-size: root.label_font_size;
        color: root.label_color;
    }

    @children
}

// Full-window dimming backdrop with a centred card. Every modal in the app is
// built from this, so they all dismiss, dim and centre the same way.
//
// Clicking the backdrop calls `dismissed()` unless `dismissable` is false;
// clicks inside the card are absorbed so they never fall through.
export component ModalOverlay inherits Rectangle {
    in property <string> title;
    in property <length> card_width: 360px;
    in property <length> card_height: 200px;
    in property <length> content_padding: 24px;
    in property <length> content_spacing: 20px;
    in property <bool> dismissable: true;
    in property <color> backdrop: Theme.overlay;

    callback dismissed();

    z: 100;
    background: root.backdrop;

    TouchArea {
        clicked => {
            if (root.dismissable) {
                root.dismissed();
            }
        }
    }

    Rectangle {
        width: root.card_width;
        height: root.card_height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border_color;
        background: Theme.bg_card;

        // Absorb clicks so they don't reach the dismiss TouchArea behind.
        TouchArea { }

        VerticalLayout {
            padding: root.content_padding;
            spacing: root.content_spacing;

            if (root.title != ""): TitleText {
                text: root.title;
            }

            @children
        }
    }
}

// Right-aligned row of modal buttons (Discard / Confirm).
export component ModalActions inherits HorizontalLayout {
    spacing: 12px;
    alignment: end;

    @children
}

// The Save / Discard / exit row shared by the editors. `standalone` swaps the
// in-app buttons for the exit pair used when the editor owns the whole window.
export component EditorActionBar inherits HorizontalLayout {
    in property <bool> standalone: false;
    // Whether the non-standalone variant offers a "Close" button (modal hosts).
    in property <bool> closable: false;

    callback save();
    // Whatever else Save & Exit must save, for an editor holding several files.
    callback save_others();
    callback discard();
    callback close();
    callback exit_standalone();

    spacing: 12px;

    MaestroButton {
        text: "Save Changes";
        primary: true;
        clicked => { root.save(); }
    }

    MaestroButton {
        text: "Discard";
        clicked => { root.discard(); }
    }

    if (root.closable && !root.standalone): MaestroButton {
        text: "Close";
        clicked => { root.close(); }
    }

    if (root.standalone): MaestroButton {
        text: "Save & Exit";
        primary: true;
        clicked => {
            root.save();
            root.save_others();
            root.exit_standalone();
        }
    }

    if (root.standalone): MaestroButton {
        text: "Exit without Saving";
        danger: true;
        clicked => { root.exit_standalone(); }
    }

    @children
}

export component Setting {
    in property <string> text;
    in property <string> subtext;
    in property <bool> has-switch: false;
    in property <bool> enabled: true;
    in-out property <bool> checked;

    callback toggled(bool);

    // A layout cannot size a row from text that wraps at a width only known
    // after layout (it measures one line), so the text width and the row
    // height are computed here instead.
    property <length> gap: 12px;
    property <length> text_x: lead.preferred-width + (root.has-switch ? root.gap : 0px);
    property <length> text_w: Math.max(0px, root.width - root.text_x - ctrl.preferred-width - root.gap);
    property <length> text_h: body.height + (root.subtext != "" ? sub.height : 0px);
    property <length> row_h: Math.max(root.text_h, Math.max(ctrl.preferred-height, lead.preferred-height));

    min-height: root.row_h;
    preferred-height: root.row_h;

    lead := HorizontalLayout {
        x: 0;
        y: (root.row_h - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;

        if (root.has-switch): MaestroSwitch {
            enabled: root.enabled;
            checked: root.checked;
            toggled(v) => root.toggled(v);
        }
    }

    body := BodyText {
        x: root.text_x;
        y: (root.row_h - root.text_h) / 2;
        width: root.text_w;
        text: text;
    }

    sub := LabelText {
        visible: root.subtext != "";
        x: root.text_x;
        y: body.y + body.height;
        width: root.text_w;
        font-size: 10px;
        text: subtext;
        wrap: word-wrap;
    }

    ctrl := HorizontalLayout {
        x: root.width - self.preferred-width;
        y: (root.row_h - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;

        @children
    }
}
